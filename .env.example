# Local-development env template — copy to `.env` and fill in.
#
# All variables are optional. If you leave them blank the backend falls back
# to the in-memory MockLakebaseClient (src/kpi_reporting/backend/mock_data.py),
# which has the same shape as the Lakebase seed — so the UI runs full-feature
# without any Databricks resources.
#
# When deployed to Databricks Apps, none of this matters: the values come
# from app.yml + bound resources at deploy time. See notebooks/03_deploy_app.py.

# Force mock mode even when Lakebase env vars are present (handy for offline UI work)
# KPI_REPORTING_FORCE_MOCK=true

# --- Lakebase (the app reads these directly when running locally) ---
# Set if you want local dev to talk to a real Lakebase project. The simplest
# way to populate them is to copy from the App's "Resources" tab in the UI
# after notebook 03 has bound the Lakebase project.
# KPI_REPORTING_LAKEBASE_PROJECT=kpi-reporting
# PGHOST=
# PGUSER=
# ENDPOINT_NAME=

# --- Genie ---
# Set to your space ID (the segment after `/genie/rooms/` in the URL) to make
# the embedded chat work locally. Leave blank to disable the chat.
# GENIE_SPACE_ID=
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# --- Confluence (optional — only needed if you want publish-to-wiki locally) ---
# KPI_REPORTING_CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
# KPI_REPORTING_CONFLUENCE_USER_EMAIL=you@your-org.com
# KPI_REPORTING_CONFLUENCE_API_TOKEN=
# KPI_REPORTING_CONFLUENCE_SPACE_KEY=
# KPI_REPORTING_CONFLUENCE_PARENT_PAGE_ID=
